{
  "name": "meraki-fpo-crop-planning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sensors": "node scripts/dev-sensors.mjs",
    "dev:trade": "node scripts/dev-trade.mjs",
    "dev:live": "node scripts/dev-live.mjs",
    "data:build": "python scripts/build_agricultural_data.py",
    "data:check": "python scripts/build_agricultural_data.py --check",
    "data:refresh-weather": "python scripts/refresh_nasa_power_weather.py",
    "data:refresh-market": "python scripts/refresh_msamb_market_snapshot.py",
    "model:validate": "python -m model_validation",
    "test:agricultural": "python -m pytest tests/test_agricultural_pipeline.py -q",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude tests/labReviewService.test.cjs && npm run test:lab",
    "test:lab": "node scripts/runLabReviewTests.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
