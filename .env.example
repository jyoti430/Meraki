# Local Vite proxies use the corresponding API launcher.
TRADE_PROXY_TARGET=http://127.0.0.1:8000
# Public-reference data gateway; no secret or farmer record is sent to providers.
LIVE_DATA_PROXY_TARGET=http://127.0.0.1:8002
# Optional frontend API prefix; never put a secret here.
# Use a same-origin reverse proxy. A different origin requires separately configured CORS.
# VITE_TRADE_API_URL=https://your-api.example/api/trade
# A single hosted API root covers trade, public data and sensor capability checks.
# Leave unset when using the checked-in Vercel same-origin /api rewrite.
# VITE_BACKEND_URL=https://your-service.onrender.com
# Python API/worker configuration. Never put real secrets in VITE_ variables.
TRADE_ENV=development
TRADE_DEMO_MODE=0
TRADE_DATABASE_URL=sqlite:///./server/trade-dev.sqlite3
# PostgreSQL test database must be disposable. Tests may clear their own records.
# TRADE_TEST_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/meraki_trade_test

# Shared Part 2 service (separate from the trade API above).
# Copy to .env for local use. Never use these settings for production.
MERAKI_ENV=development
MERAKI_DEV_AUTH=0
MERAKI_DATABASE_URL=sqlite:///./server/meraki-dev.sqlite3
MERAKI_DOCUMENT_ROOT=./var/documents
MERAKI_AUTO_CREATE_SCHEMA=0

# PostgreSQL example (configure credentials outside source control):
# MERAKI_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/meraki

# Render only: configure in the service environment, never commit the real URL.
# DATABASE_URL=<Render internal PostgreSQL URL>
# HOSTED_MODE=demo
# CORS_ALLOWED_ORIGINS=https://meraki-tau-opal.vercel.app
# Start: python -m server.start_hosted (migrates before serving).
# HOSTED_MODE=production deliberately blocks trade pending verified adapters.

# No-email auction accounts (new organisation per account).
MERAKI_PASSWORD_AUTH=1
MERAKI_ALLOW_REGISTRATION=1
MERAKI_POSTGRES_PASSWORD=
MERAKI_CORS_ORIGINS=

# Local crate gateway SMS. Put real values only in ignored .env, then restart
# npm run dev:sensors. Node 20.12+ is required to load this file in the launcher.
# Distinct keys: firmware gets the push key; only the operator gets the admin key.
# Blank keys are generated and printed locally by the sensor launcher.
SENSOR_PUSH_TOKEN=
SENSOR_ADMIN_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Supply an SMS-capable Twilio sender OR a Messaging Service SID.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
