# Vite forwards only /api/trade during local development.
TRADE_PROXY_TARGET=http://127.0.0.1:8000
# Public-reference data gateway; no secret or farmer record is sent to providers.
LIVE_DATA_PROXY_TARGET=http://127.0.0.1:8002
# Optional frontend API prefix; never put a secret here.
# Use a same-origin reverse proxy. A different origin requires separately configured CORS.
# VITE_TRADE_API_URL=https://your-api.example/api/trade
# Python API/worker configuration. Never put real secrets in VITE_ variables.
TRADE_ENV=development
TRADE_DEMO_MODE=0
TRADE_DATABASE_URL=sqlite:///./server/trade-dev.sqlite3
# PostgreSQL test database must be disposable. Tests may clear their own records.
# TRADE_TEST_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/meraki_trade_test
